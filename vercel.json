{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "src/db/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/sparse",
      "destination": "/public/sparse-glow.html"
    },
    {
      "source": "/plan",
      "destination": "/public/plan.html"
    },
    {
      "source": "/",
      "destination": "/public/sparse-glow.html"
    }
  ]
}
