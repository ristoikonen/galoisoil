{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "galois-jsx",
    "baseUrl": ".",
    "paths": {
      "galois-jsx/*": ["./src/docs/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.ts", "src/**/*.ts", "src/**/*.tsx"]
}
